# Edit only if you also update CORE_PUBLIC_ORIGIN and clients.
https://core.local {
    tls internal
    encode gzip
    header {
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy no-referrer
        Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'"
    }
    handle /api/* {
        reverse_proxy 127.0.0.1:8780 {
            header_up X-Forwarded-For {remote_host}
            transport http {
                dial_timeout 2s
                response_header_timeout 15s
            }
        }
    }
    handle {
        root * /opt/risarms/frontend
        file_server
    }
    handle_errors {
        @api path /api/*
        handle @api {
            header Content-Type application/json
            respond `{"error":"CORE or SSD storage is unavailable. Ask the administrator to check the Pi services."}` 503
        }
        handle {
            respond "RISARMS portal is unavailable." 503
        }
    }
}
