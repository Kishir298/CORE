# Shell scripts must be LF in the working tree on every platform. Windows
# runners default to core.autocrlf=true, and a CRLF checkout makes `bash -n`
# fail with "syntax error near unexpected token `$'{\r''" and would break a
# real deployment. `eol=lf` overrides core.autocrlf, so checkout stays LF.
*.sh text eol=lf
