{
  "schema_version": 1,
  "project": "CORE",
  "display_name": "C.O.R.E. — Communication, Organization and Resource Engine",
  "version": "0.6.0",
  "release_channel": "beta",
  "standalone": true,
  "components": {
    "host": {
      "package": "core",
      "version": "0.6.0",
      "console_scripts": ["core-host"]
    },
    "client": {
      "package": "core-client",
      "version": "0.6.0",
      "console_scripts": ["core-client"]
    },
    "rescs": {
      "package": "rescs",
      "version": "0.4.0",
      "bundled": true
    }
  },
  "server_deployment": {
    "os": "linux",
    "distribution": "void",
    "architectures": ["x86_64"],
    "libc": "glibc",
    "init": "runit",
    "install_methods": ["source-release-archive"],
    "notes": "CORE 0.6.0 server releases target Void Linux x86_64 glibc only. Other platforms are not supported for the server."
  },
  "supported_operating_systems": [
    {
      "os": "linux",
      "distribution": "void",
      "architectures": ["x86_64"],
      "role": "server",
      "libc": "glibc",
      "init": "runit",
      "notes": "Release-grade server target. Installer and runit services are shipped from the release archive."
    },
    {
      "os": "windows",
      "architectures": ["x86_64", "arm64"],
      "role": "legacy-client",
      "minimum_version": "10 22H2",
      "notes": "Legacy CORE-CLIENT only. Not part of the CORE 0.6.0 server release."
    },
    {
      "os": "macos",
      "architectures": ["x86_64", "arm64"],
      "role": "legacy-client",
      "minimum_version": "12.0",
      "notes": "Legacy CORE-CLIENT only. Desktop and browser modes are delivered by RISARMS-ui 0.6.0."
    },
    {
      "os": "linux",
      "architectures": ["x86_64", "arm64"],
      "role": "legacy-client",
      "minimum_version": "glibc 2.28",
      "notes": "Legacy CORE-CLIENT only. Not part of the CORE 0.6.0 server release."
    }
  ],
  "runtime": {
    "kind": "python",
    "minimum_version": "3.10",
    "install_methods": ["source-release-archive", "pip"]
  },
  "core_protocol": {
    "version": "0.4.0",
    "supported_versions": ["0.3.0", "0.4.0"],
    "negotiated_on_handshake": true,
    "source": "CORE/CORE-HOST/core/communication/protocol.py"
  },
  "integrations": ["rescs", "asis", "ascs", "tiviss"],
  "build_metadata": {
    "builder": "GitHub Actions",
    "artifact_naming": "CORE-Server-{version}-void-x86_64-{format}",
    "checksums": "SHA-256",
    "sbom": "CycloneDX JSON"
  }
}
